VISA_CC_MEMBERS="true"

# ── Auth ─────────────────────────────────────────────────────────────
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD="change-this-to-something-secure-12chars"
ATTENDANCE_PASSWORD="change-this-different-from-admin-12chars"
SESSION_SECRET="generate-32-hex-bytes-with-the-command-above"
LINK_SECRET="generate-another-32-hex-bytes-different-from-session"
CRON_SECRET="generate-16-hex-bytes-at-minimum"

# ── Config ───────────────────────────────────────────────────────────
